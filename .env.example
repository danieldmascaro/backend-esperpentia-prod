DJANGO_ENV=production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-strong-secret
DATABASE_URL=postgresql://user:password@host:5432/dbname
DJANGO_ALLOWED_HOSTS=.onrender.com

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD=replace-with-app-password
DEFAULT_FROM_EMAIL=you@example.com

PASSWORD_RESET_CONFIRM_URL=password/reset/confirm/{uid}/{token}
ACTIVATION_URL=activate/{uid}/{token}

WEBPAY_COMMERCE_CODE=replace-with-production-commerce-code
WEBPAY_API_KEY=replace-with-production-api-key
WEBPAY_ENVIRONMENT=LIVE
WEBPAY_RETURN_URL=https://esperpentia-backend.onrender.com/payments/webpay/return/
WEBPAY_FRONTEND_RESULT_URL=https://esperpentia.vercel.app/checkout/resultado
PAYMENTS_WEBHOOK_SECRET=replace-with-webhook-secret

CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://esperpentia.vercel.app,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=https://esperpentia.vercel.app,http://localhost:5173,http://127.0.0.1:5173
EMAIL_FRONTEND_PROTOCOL=https
EMAIL_FRONTEND_DOMAIN=esperpentia.vercel.app
EMAIL_FRONTEND_SITE_NAME=Esperpentia Frontend

CHILEXPRESS_API_COBERTURA_KEY=replace-if-needed
CHILEXPRESS_API_COTIZADOR_KEY=replace-if-needed
